{
  "schema_version": 1,
  "reviewed_on": "2026-10-19",
  "authorization": {
    "subagents": "allowed_by_default",
    "permission_persists": true,
    "concurrency_policy": "at_most_PROJECT_yaml_workflow_subagent_concurrency",
    "nested_delegation": "allowed_when_bounded_and_policy_compliant",
    "single_writer_per_file": true,
    "model_selection": "free_choice_by_root_agent_routes_are_suggestions"
  },
  "providers": {
    "allowed": ["hosted_frontier_models_exposed_by_the_active_runtime"],
    "local_model_ban_reason": "translation_quality",
    "local_language_models": "prohibited",
    "local_machine_translation": "prohibited",
    "local_ocr_or_stt": "explicit_user_authorization_per_current_task",
    "external_ai_services": "explicit_named_service_authorization_per_current_task_except_intake_approved_openai_official_image_editing",
    "forbidden_local_ids": [
      "ollama",
      "llama.cpp",
      "llamacpp",
      "localai",
      "argos-translate",
      "argostranslate",
      "libretranslate",
      "transformers-local"
    ]
  },
  "runtimes": {
    "codex": {
      "instructions": "AGENTS.md",
      "skills_dir": ".agents/skills",
      "per_agent_model_selection": "runtime_dependent",
      "nested_delegation": "runtime_dependent"
    },
    "claude-code": {
      "instructions": "CLAUDE.md (imports AGENTS.md)",
      "skills_dir": ".claude/skills (generated from .agents/skills by scripts/sync_runtime.py)",
      "per_agent_model_selection": "supported",
      "nested_delegation": "unsupported_root_agent_fans_out"
    }
  },
  "tiers": {
    "light": "the lightest model the active runtime offers at work time",
    "standard": "a middle model the active runtime offers at work time",
    "deep": "the strongest model the active runtime offers at work time"
  },
  "roles": {
    "source_dir": ".agents/roles",
    "claude_code": ".claude/agents (generated by scripts/sync_runtime.py)",
    "codex": "python scripts/make_subagent_brief.py --role <role> --task <task> --scope <paths>",
    "separation": "the proofreader of a unit must differ from its translator"
  },
  "mixed_runtime": {
    "shared_state": "files_only",
    "single_writer_per_file_across_runtimes": true,
    "record_active_scope_in": "PLAN.md"
  },
  "routing": {
    "mechanical": {
      "tier": "light",
      "effort": "low",
      "use_for": "inventory, counting, hashes, token comparison, simple extraction, deterministic checks"
    },
    "scoped_edit": {
      "tier": "light",
      "effort": "medium",
      "use_for": "small mechanical edits or coordinated updates from a clear brief"
    },
    "ui_translation": {
      "tier": "standard",
      "effort": "low",
      "use_for": "clear UI translation with established context, terminology, and deterministic QA"
    },
    "contextual_translation": {
      "tier": "standard",
      "effort": "medium",
      "use_for": "dialogue, narrative, character voice, and contextual bulk translation"
    },
    "research": {
      "tier": "light",
      "effort": "medium",
      "use_for": "read-only research on engines, tools, mods, and game versions; returns a short evidence-backed answer"
    },
    "image_work": {
      "tier": "standard",
      "effort": "medium",
      "use_for": "localizing text baked into an assigned set of images, isolating their visual context from the root agent"
    },
    "proofreading": {
      "tier": "standard",
      "effort": "medium",
      "use_for": "independent one-pass Arabic proofreading of a translated batch by an agent that did not translate it"
    },
    "deep_review": {
      "tier": "standard",
      "effort": "high",
      "use_for": "wordplay, ambiguity, sensitive language, deep review, or complex debugging"
    },
    "architecture": {
      "tier": "deep",
      "effort": "medium",
      "use_for": "conflicting evidence, risky architecture, integration strategy, or final adjudication"
    },
    "exceptional": {
      "tier": "deep",
      "effort": "xhigh",
      "use_for": "exceptional long-running work only after a representative evaluation shows material benefit"
    }
  },
  "escalation_triggers": [
    "unresolved_semantic_ambiguity",
    "conflicting_project_evidence",
    "repeated_verification_failure",
    "hard_to_reverse_decision",
    "broad_cross_file_reasoning",
    "representative_eval_quality_gain",
    "dense_protected_markup",
    "repeated_batch_split_failure"
  ],
  "required_brief_fields": [
    "objective",
    "deliverable",
    "scope",
    "write_mode",
    "model_and_effort",
    "context_and_constraints",
    "acceptance_checks",
    "local_ai_ban",
    "external_service_boundary",
    "nested_delegation_boundary",
    "report_contract"
  ]
}
